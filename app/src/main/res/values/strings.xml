    <!-- auto-change troubleshooting help screen -->
    <string name="auto_help_title">Auto-Change Help</string>
    <string name="auto_help_why_title">Why Auto-Change Stops Working</string>
    <string name="auto_help_why_body">Many phone brands include aggressive battery savers that force-stop background apps which stop auto-change when your screen is off. Setting Rimalux to Unrestricted lets auto-change run reliably with virtually zero battery drain.</string>

